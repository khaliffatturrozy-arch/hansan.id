generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  CARD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

// ─────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  menuItems    MenuItem[]
}

model MenuItem {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  price       Int         // Stored in IDR (integer, no decimals)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  stockCount  Int         @default(100)
  badge       String?     // "Signature" | "Best Seller" | "New" | "Promo" | null
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique  // e.g. HN-20260919-1234
  idempotencyKey  String?       @unique
  orderType       OrderType     @default(DINE_IN)
  tableNumber     String?
  customerName    String?
  cashierName     String?
  subtotal        Int           // IDR integer
  taxPb1          Int           // 10% PB1 restaurant tax, IDR integer
  totalAmount     Int           // subtotal + taxPb1
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH)
  amountPaid      Int           @default(0)
  changeAmount    Int           @default(0)
  bankName        String?       // for CARD payments
  approvalCode    String?       // EDC trace/approval number
  notes           String?       @db.Text
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity   Int      @default(1)
  unitPrice  Int      // snapshot of price at time of order (IDR)
  subtotal   Int      // quantity * unitPrice
  notes      String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}
