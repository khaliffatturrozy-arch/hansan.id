generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  CARD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

// ─────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────

model Organization {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  outlets    Outlet[]
  staff      Staff[]
  roles      Role[]
  categories Category[] @relation("OrganizationCategories")
  orders     Order[]    @relation("OrganizationOrders")

  @@index([slug])
}

model Outlet {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  staff          Staff[]
  orders         Order[]   @relation("OutletOrders")

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Staff {
  id             String      @id @default(cuid())
  authUserId     String      @unique
  email          String      @unique
  firstName      String
  lastName       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outletId       String?
  outlet         Outlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  status         String      @default("ACTIVE")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  roles          StaffRole[]
  orders         Order[]
  auditEvents    AuditLog[]  @relation("ActorStaff")

  @@index([organizationId])
  @@index([outletId])
}

model Permission {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  createdAt   DateTime        @default(now())
  roles       RolePermission[]
}

model Role {
  id             String        @id @default(cuid())
  // PLATFORM-ROLE OWNERSHIP MODEL (Phase B decision):
  //  - Tenant roles  : isPlatform = false → organizationId is REQUIRED.
  //  - Platform roles: isPlatform = true  → organizationId is NULL.
  // Platform roles are global definitions not owned by any tenant. The invariant
  // is enforced by the Role_platform_org_check CHECK constraint created in the
  // Phase B migration (PostgreSQL, raw SQL — Prisma cannot express CHECK).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String        @unique
  description    String?
  isPlatform     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  permissions    RolePermission[]
  staffRoles     StaffRole[]

  // Scoped to tenant roles. Platform roles (organizationId IS NULL) are governed
  // by the globally unique `code` above, because PostgreSQL treats NULLs as
  // distinct in unique indexes.
  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isPlatform])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model StaffRole {
  staffId String
  roleId  String
  staff   Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role    Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorStaffId  String?
  actorStaff    Staff?    @relation("ActorStaff", fields: [actorStaffId], references: [id], onDelete: SetNull)
  actorUserId   String?
  organizationId String?
  outletId      String?
  entityType    String
  entityId      String?
  action        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([outletId])
  @@index([entityType, entityId])
}

// Categories are ORGANIZATION-owned (tenant-owned). They are deliberately NOT
// outlet-scoped: a menu taxonomy is shared across all outlets of a tenant.
// Outlet-specific availability, if ever required, belongs on MenuItem.
model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  displayOrder   Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  menuItems      MenuItem[]

  // A slug is unique WITHIN a tenant, not globally: two organizations may each
  // legitimately own a "coffee" category. The previous global uniqueness made
  // multi-tenancy impossible.
  @@unique([organizationId, slug])
  // Composite key required so MenuItem can carry a tenant-scoped foreign key
  // back to its category. See MenuItem.category.
  @@unique([id, organizationId])
}

model MenuItem {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  description    String?     @db.Text
  price          Int         // Stored in IDR (integer, no decimals)
  imageUrl       String?
  isAvailable    Boolean     @default(true)
  stockCount     Int         @default(100)
  badge          String?     // "Signature" | "Best Seller" | "New" | "Promo" | null
  categoryId     String
  // TENANT-SCOPED COMPOSITE RELATION.
  // The database enforces that a menu item's organizationId always equals its
  // category's organizationId. It is therefore impossible to attach a menu item
  // to another organization's category, and any tenant-scoped menu query that
  // filters on organizationId cannot cross tenants.
  category       Category    @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([organizationId])
  @@index([categoryId, organizationId])
}

model Order {
  id              String        @id @default(cuid())
  // TENANT OWNERSHIP IS MANDATORY.
  // An order that is not attributable to an organization, an outlet, and a staff
  // member cannot be audited, reconciled, or tenant-isolated. All three are
  // derived server-side from the authenticated staff context (never the client).
  organizationId  String
  organization    Organization  @relation("OrganizationOrders", fields: [organizationId], references: [id], onDelete: Restrict)
  outletId        String
  outlet          Outlet        @relation("OutletOrders", fields: [outletId], references: [id], onDelete: Restrict)
  staffId         String
  // Restrict (not SetNull): the staff column is required, and order history must
  // not lose its cashier. Staff are deactivated via Staff.status, never hard-deleted.
  staff           Staff         @relation(fields: [staffId], references: [id], onDelete: Restrict)
  orderNumber     String        @unique  // e.g. HN-20260919-1234
  idempotencyKey  String?       @unique
  orderType       OrderType     @default(DINE_IN)
  tableNumber     String?
  customerName    String?
  cashierName     String?
  subtotal        Int           // IDR integer
  taxPb1          Int           // 10% PB1 restaurant tax, IDR integer
  totalAmount     Int           // subtotal + taxPb1
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(CASH)
  amountPaid      Int           @default(0)
  changeAmount    Int           @default(0)
  bankName        String?       // for CARD payments
  approvalCode    String?       // EDC trace/approval number
  notes           String?       @db.Text
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Index plan (verified against real query patterns, not speculative):
  //  - (organizationId, outletId, createdAt) → POS recent-orders list
  //    (src/lib/order-service.ts#listRecentOrders)
  //  - (organizationId, status) → Owner HQ counters/aggregates
  //    (src/app/owner/page.tsx)
  // The previous single-column organizationId index became a redundant prefix of
  // the first composite and was removed. The bare idempotencyKey index duplicated
  // the index already created by @unique and was removed.
  @@index([organizationId, outletId, createdAt])
  @@index([organizationId, status])
  @@index([outletId])
  @@index([createdAt])
  @@index([status])
  @@index([staffId])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity   Int      @default(1)
  unitPrice  Int      // snapshot of price at time of order (IDR)
  subtotal   Int      // quantity * unitPrice
  notes      String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────
// DEVELOPER / PLATFORM ACCESS (tenant-independent)
// ─────────────────────────────────────────────────────────────────

// DeveloperAccess is the AUTHORITATIVE Developer/platform authorization boundary.
// It is intentionally separate from Staff → StaffRole → Role: Staff is
// tenant-bound (organizationId NOT NULL) while platform authority is
// tenant-independent. Joining a tenant Staff row to a global platform Role
// would create a privilege-confusion hazard, so StaffRole must NEVER be used
// to grant Developer access.
//
// - authUserId is the SOLE identity key (Supabase auth.users.id).
// - email is stored normalized lowercase for operator display only; it is NOT
//   the identity key (an email change in Auth must not re-key access).
// - status follows the existing Staff convention (String, not a Prisma enum:
//   Staff.status is also a free String holding ACTIVE | INACTIVE | SUSPENDED).
//   Allowed values: ACTIVE | SUSPENDED. Records are deactivated via status,
//   never hard-deleted (auditable kill switch).
// - No organizationId / outletId / staffId / roleId / permissions / password.
//   There are no foreign keys to any tenant table.
model DeveloperAccess {
  id          String    @id @default(cuid())
  authUserId  String    @unique
  email       String
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  @@index([status])
}
