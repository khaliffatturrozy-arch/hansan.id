# Database connection string for Supabase (via pooler - for Prisma ORM queries)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?pgbouncer=true&connect_timeout=15
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct URL - used for schema migrations (bypasses pgbouncer, required for prisma db push/migrate)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase public credentials for client-side features (realtime, storage, auth)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
