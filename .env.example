# ─────────────────────────────────────────────────────────────────────────────
# HANSAN — ENVIRONMENT VARIABLE REFERENCE (TEMPLATE ONLY)
# ─────────────────────────────────────────────────────────────────────────────
# This file is a TEMPLATE. It must never contain real credential values.
# Copy it to `.env` (or configure the values in your secret manager) and fill in
# real values per environment. `.env` is git-ignored and must never be committed.
#
# Variables listed below are EXACTLY the ones referenced by the application
# source code. Verified against src/ and prisma/ during Phase A.
#
# Blank values are intentional in this template. A fresh environment with blank
# DATABASE_URL / DIRECT_URL will fail Prisma commands with `P1012` by design
# rather than silently connecting to an unintended database.

# ── Database (Prisma / PostgreSQL) ───────────────────────────────────────────
# Required: yes
# Used by: prisma/schema.prisma (datasource url), src/lib/order-service.ts
# Usage: server-only. Never expose to the browser.
DATABASE_URL=""

# Required: yes
# Used by: prisma/schema.prisma (datasource directUrl — required for migrations)
# Usage: server-only. Never expose to the browser.
DIRECT_URL=""

# ── Supabase: public/client-visible configuration ────────────────────────────
# Required: yes
# Used by: src/middleware.ts, src/lib/auth.ts, src/lib/supabase.ts,
#          src/lib/supabase-server.ts, src/app/login/page.tsx, src/app/owner/page.tsx
# Usage: client-visible (prefixed NEXT_PUBLIC_). Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=""

# Required: yes
# Used by: src/middleware.ts, src/lib/auth.ts, src/lib/supabase.ts,
#          src/lib/supabase-server.ts, src/app/login/page.tsx, src/app/owner/page.tsx
# Usage: client-visible (prefixed NEXT_PUBLIC_). Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Supabase: privileged server-only configuration ───────────────────────────
# Required: yes (server-side authentication fails closed without it)
# Used by: src/lib/auth.ts, src/lib/supabase-server.ts,
#          src/app/api/auth/provision/route.ts
# Usage: server-only. Must NEVER be exposed to the browser or the client bundle.
# Server-side token validation intentionally does NOT fall back to the anon key.
SUPABASE_SERVICE_ROLE_KEY=""

# ── HANSAN platform provisioning ─────────────────────────────────────────────
# Required: yes (only for first-time owner provisioning)
# Used by: src/app/api/auth/provision/route.ts (checked via the
#          `X-Provision-Secret` request header using constant-time comparison)
# Usage: server-only. Gates `POST /api/auth/provision` so that an arbitrary
#        authenticated Supabase user cannot self-provision as OWNER.
#        Generate a long random value; treat it like a credential.
HANSAN_PROVISION_SECRET=""

# ── HANSAN developer (platform) provisioning ───────────────────────────────
# Required: yes (only for bootstrap developer provisioning)
# Used by: src/app/api/auth/developer-provision/route.ts (checked via the
#          `X-Developer-Provision-Secret` request header using constant-time comparison)
# Usage: server-only. Gates `POST /api/auth/developer-provision` so that an
#        arbitrary caller cannot self-provision Developer access. MUST differ
#        from HANSAN_PROVISION_SECRET: anyone holding the tenant bootstrap
#        secret must not be able to mint platform authority.
#        Generate a long random value; treat it like a credential.
#        NOTE: this endpoint has no rate limiting yet — see the route header.
HANSAN_DEVELOPER_PROVISION_SECRET=""
